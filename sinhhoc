image:"https://upload.wikimedia.org/wikipedia/commons/1/1b/Meiosis_Crossing_Over.svg",
options:[
"Nguyên phân",
"Giảm phân và thụ tinh",
"Đột biến gen",
"Đột biến NST"
],
correct:1,
explanation:"Biến dị tổ hợp hình thành nhờ giảm phân và thụ tinh."
},

{
topic:"Quần thể",
question:"19. Kích thước quần thể là:",
image:"https://upload.wikimedia.org/wikipedia/commons/1/17/School_of_fish.jpg",
options:[
"Số lượng cá thể",
"Số loài",
"Số gen",
"Số alen"
],
correct:0,
explanation:"Kích thước quần thể là số lượng cá thể."
},

{
topic:"Phép lai",
question:"20. Tỉ lệ kiểu hình 3:1 xuất hiện ở phép lai:",
image:"https://upload.wikimedia.org/wikipedia/commons/8/87/Punnett_square_mendel_flowers.svg",
options:[
"Aa × Aa",
"AA × aa",
"Aa × aa",
"AA × AA"
],
correct:0,
explanation:"Lai hai cơ thể dị hợp Aa × Aa cho tỉ lệ kiểu hình 3:1."
}

];

const quizContainer = document.getElementById("quiz");
const scoreBox = document.getElementById("scoreBox");

let score = 0;
let answered = 0;

questions.forEach((q,index)=>{

const box = document.createElement("div");
box.className = "question-box";

box.innerHTML = `
<div class="topic">${q.topic}</div>
<div class="question">${q.question}</div>
<img class="bio-image" src="${q.image}" alt="Biology Image">
`;

q.options.forEach((option,i)=>{

const button = document.createElement("button");
button.className = "option";
button.innerHTML = option;

button.onclick = ()=>{

const allOptions = box.querySelectorAll(".option");

allOptions.forEach(btn=>{
btn.classList.add("disabled");
});

if(i===q.correct){
button.classList.add("correct");
score++;
}else{
button.classList.add("wrong");
allOptions[q.correct].classList.add("correct");
}

const answer = box.querySelector(".answer");
answer.style.display = "block";

answered++;

if(answered===questions.length){
scoreBox.innerHTML =
`Bạn đạt <span style="color:green">${score}/${questions.length}</span> câu đúng!`;
}

};

box.appendChild(button);

});

const answer = document.createElement("div");
answer.className = "answer";

answer.innerHTML = `
<strong>Đáp án đúng:</strong> ${q.options[q.correct]}
<br><br>
<strong>Giải thích:</strong> ${q.explanation}
`;

box.appendChild(answer);

quizContainer.appendChild(box);

});

</script>

</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Đề Thi Sinh Học Trắc Nghiệm</title>

<style>

body{
    font-family: Arial, sans-serif;
    background:#f4f7fb;
    margin:0;
    padding:20px;
    color:#222;
}

h1{
    text-align:center;
    color:#0d47a1;
    margin-bottom:40px;
}

.quiz-container{
    max-width:1000px;
    margin:auto;
}

.question-box{
    background:white;
    padding:20px;
    border-radius:12px;
    margin-bottom:25px;
    box-shadow:0 4px 10px rgba(0,0,0,0.08);
}

.question{
    font-size:18px;
    font-weight:bold;
    margin-bottom:15px;
}

.bio-image{
    width:100%;
    max-width:350px;
    border-radius:10px;
    margin:15px 0;
    border:2px solid #dce6ff;
}

.option{
    display:block;
    width:100%;
    text-align:left;
    padding:12px;
    margin:10px 0;
    border:none;
    border-radius:8px;
    background:#e8eefc;
    cursor:pointer;
    transition:0.3s;
    font-size:16px;
}

.option:hover{
    background:#d5e3ff;
}

.correct{
    background:#4CAF50 !important;
    color:white;
}

.wrong{
    background:#f44336 !important;
    color:white;
}

.disabled{
    pointer-events:none;
}

.answer{
    margin-top:15px;
    padding:12px;
    border-left:5px solid #0d47a1;
    background:#eef4ff;
    border-radius:8px;
    display:none;
}

.score-box{
    text-align:center;
    font-size:28px;
    font-weight:bold;
    margin-top:40px;
    color:#0d47a1;
}

.topic{
    color:#1565c0;
}

</style>
</head>

<body>

<h1>ĐỀ THI TRẮC NGHIỆM SINH HỌC</h1>

<div class="quiz-container" id="quiz"></div>

<div class="score-box" id="scoreBox"></div>

